---
import { getCollection, render } from 'astro:content';
import ArtworkSection from '../components/ArtworkSection.astro';
import ArtworkViewer from '../components/ArtworkViewer.astro';
import Header from '../components/Header.astro';
import MarketEssay from '../components/MarketEssay.astro';
import Quiz from '../components/Quiz.astro';
import Sources from '../components/Sources.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Timeline from '../components/Timeline.astro';

const entries = (await getCollection('artworks')).sort((a, b) => a.data.order - b.data.order);
const artworks = await Promise.all(entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })));
const artworkByTimeline = new Map<string, typeof entries>();

for (const entry of entries) {
  for (const timelineId of entry.data.timelineIds) {
    const linkedArtworks = artworkByTimeline.get(timelineId) ?? [];
    linkedArtworks.push(entry);
    artworkByTimeline.set(timelineId, linkedArtworks);
  }
}

const timelineEvents = (await getCollection('timeline'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((event) => ({
    ...event,
    artworks: artworkByTimeline.get(event.id) ?? [],
  }));
const hero = artworks[0].entry.data;
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="光线照进现代巴黎｜印象派与现代城市生活"
  description="从四幅作品理解19世纪巴黎的城市改造、工业化、消费文化与艺术市场。"
>
  <Header heroImage={`${base}${hero.image}`} heroAlt={hero.imageAlt} />
  <main class="exhibition-main" id="main-content">
    <section class="section-intro" aria-labelledby="exhibition-title">
      <p class="eyebrow intro-label">策展引言</p>
      <h2 id="exhibition-title">为什么是此时，为什么是巴黎？</h2>
      <p>印象派并非只是一种画法。它也是快速变化的城市、交通、消费和观看习惯留下的视觉记录。</p>
    </section>
    <Timeline events={timelineEvents} base={base} />
    <ArtworkViewer artworks={artworks} base={base} />
    <MarketEssay variant="city" />
    <section class="artworks" id="artworks" aria-label="四幅核心作品">
      {artworks.map(({ entry, Content }) => <ArtworkSection entry={entry} Content={Content} base={base} />)}
    </section>
    <MarketEssay variant="market" />
    <Quiz />
    <Sources artworks={entries} />
  </main>
</BaseLayout>
