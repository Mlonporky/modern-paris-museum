---
import type { CollectionEntry } from 'astro:content';

type TimelineEvent = CollectionEntry<'timeline'> & {
  artworks: CollectionEntry<'artworks'>[];
};

interface Props {
  events: TimelineEvent[];
  base: string;
}

const { events, base } = Astro.props;
---

<section class="timeline-section" id="timeline" aria-labelledby="timeline-title">
  <div class="section-intro">
    <p class="eyebrow">历史坐标</p>
    <h2 id="timeline-title">一座城市怎样变成“现代”</h2>
    <p>我们不按年份逐格罗列事件，而是沿着四个主题阶段，观察街道、火车、休闲和市场如何进入画面。</p>
  </div>
  <div class="timeline-layout">
    <nav class="timeline-nav" aria-label="艺术阶段导航">
      <p class="timeline-nav-label">选择一个作品阶段</p>
      <ol class="timeline-list">
        {events.map(({ id, data }, index) => (
          <li>
            <button
              class="timeline-event"
              type="button"
              id={`timeline-button-${id}`}
              data-timeline-event={id}
              data-category={data.category}
              data-timeline-button={id}
              data-timeline-aliases={data.legacyIds?.join(',') ?? ''}
              aria-controls={`timeline-panel-${id}`}
              aria-pressed={index === 0 ? 'true' : 'false'}
            >
              <span class="timeline-year">{data.yearLabel}</span>
              <span class="timeline-category">{data.category}</span>
              <strong>{data.title}</strong>
            </button>
          </li>
        ))}
      </ol>
    </nav>

    <div class="timeline-panels" aria-live="polite">
      {events.map(({ id, data, artworks }, index) => (
        <article
          class="timeline-panel"
          id={`timeline-panel-${id}`}
          data-timeline-panel={id}
          aria-labelledby={`timeline-button-${id}`}
          hidden={index !== 0}
        >
          <div class="timeline-panel-copy">
            <p class="timeline-panel-kicker">{data.yearLabel} · {data.category}</p>
            <h3>{data.title}</h3>
            <p>{data.description}</p>
          </div>

          {artworks.length > 0 ? (
            <div class="timeline-artwork-grid" aria-label={`${data.title}中的作品`}>
              {artworks.map((artwork) => (
                <a
                  class="timeline-artwork-card"
                  href={`#${artwork.id}`}
                  data-artwork-card={artwork.id}
                  data-artwork-open={artwork.id}
                >
                  <img
                    src={`${base}${artwork.data.image}`}
                    alt={artwork.data.imageAlt}
                    loading="lazy"
                  />
                  <div class="timeline-artwork-card-copy">
                    <p>{artwork.data.artist} · {artwork.data.year}</p>
                    <h4>{artwork.data.title}</h4>
                    <p class="timeline-artwork-card-theme">{artwork.data.theme}</p>
                    <p class="timeline-artwork-card-summary">{artwork.data.summary}</p>
                    <span>查看作品解读</span>
                  </div>
                </a>
              ))}
            </div>
          ) : (
            <p class="timeline-empty">这个阶段暂时没有直接关联的作品，我们先把它作为背景资料保留。</p>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<script src="../scripts/timeline.mjs"></script>
